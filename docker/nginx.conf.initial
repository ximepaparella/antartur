# Nginx configuration for initial SSL certificate setup
# This config is used ONLY during the first certbot certificate request
# After certificates are obtained, switch to nginx.conf

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    upstream nextjs {
        server app:3000;
    }

    # HTTP server - for ACME challenge and temporary access
    server {
        listen 80;
        listen [::]:80;
        server_name coderoots.tech www.coderoots.tech;

        # Let's Encrypt ACME challenge
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Temporarily serve app via HTTP until SSL is configured
        location / {
            proxy_pass http://nextjs;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }
    }
}

