# =============================================================================
# Antartur - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# =============================================================================

# =============================================================================
# DATABASE (Required)
# =============================================================================
POSTGRES_USER=antartur
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=antartur

# For Docker Compose (internal network)
# DATABASE_URL is constructed automatically in docker-compose.prod.yml
# For local development without Docker:
# DATABASE_URL=postgresql://antartur:password@localhost:5432/antartur

# =============================================================================
# SITE CONFIGURATION (Required)
# =============================================================================
SITE_URL=https://coderoots.tech
NEXT_PUBLIC_SITE_URL=https://coderoots.tech

# =============================================================================
# AUTHENTICATION (Required)
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=GENERATE_A_SECURE_SECRET_HERE

# =============================================================================
# EMAIL CONFIGURATION (Choose one option)
# =============================================================================

# Option A: Gmail (easiest for getting started)
# Requires App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Option B: SMTP (for professional production)
# SMTP_HOST=smtp.your-server.com
# SMTP_PORT=587
# SMTP_USER=smtp_username
# SMTP_PASS=smtp_password
# SMTP_FROM=noreply@coderoots.tech

# Email recipient for contact form and booking copies
CONTACT_EMAIL=info@coderoots.tech
CONTACT_RECIPIENT_EMAIL=info@coderoots.tech

# =============================================================================
# RECAPTCHA (Optional - for contact form protection)
# =============================================================================
# Get keys at: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# =============================================================================
# CRON JOBS (Required for order expiration and notifications)
# =============================================================================
# Generate with: openssl rand -hex 32
CRON_SECRET=GENERATE_A_SECURE_CRON_SECRET_HERE

# =============================================================================
# ORDER EXPIRATION (Optional - has defaults)
# =============================================================================
ORDER_EXPIRATION_HOURS=1
BANK_TRANSFER_EXPIRATION_HOURS=24

# =============================================================================
# PAYMENT GATEWAYS
# =============================================================================

# PayPal (for USD payments)
# Get credentials at: https://developer.paypal.com/
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=live  # sandbox for testing, live for production

# Payway (for ARS payments)
# Documentation: https://developers.payway.com.ar/
# Use a local .env (gitignored) for real values; never commit real keys.
# The frontend gets the public key at runtime via GET /api/config/payway (no build-time env needed).
PAYWAY_API_KEY=REPLACE_ME
PAYWAY_MERCHANT_ID=REPLACE_ME
PAYWAY_SITE_ID=REPLACE_ME
PAYWAY_TEMPLATE_ID=REPLACE_ME
PAYWAY_ENVIRONMENT=sandbox
# Public key for SDK (exposed by /api/config/payway to the client)
PAYWAY_PUBLIC_KEY=REPLACE_ME

# =============================================================================
# BANK DETAILS (for bank transfer payments)
# =============================================================================
BANK_ACCOUNT_NAME=Account Holder Name
BANK_ACCOUNT_NUMBER=1234567890
BANK_NAME=Bank Name
BANK_CUIT=XX-XXXXXXXX-X
BANK_CBU=0000000000000000000000
BANK_ALIAS=account-alias

# =============================================================================
# NOTIFICATIONS (Optional)
# =============================================================================
# Set to true to log emails without sending (for testing)
NOTIFICATION_DRY_RUN=false

# =============================================================================
# BOOKING RESTRICTIONS
# =============================================================================
# Hour (0-23) after which reservations for the next day are blocked (Argentina timezone)
# Default: 20 (8 PM) - After 8 PM, users cannot book for tomorrow
NEXT_PUBLIC_BOOKING_CUTOFF_HOUR=20

# Hours that a pending reservation holds seats before auto-cancellation
# Default: 2 - Pending reservations hold seats for 2 hours, then auto-cancel if not confirmed
PENDING_RESERVATION_HOLD_HOURS=2

# =============================================================================
# JWT AUTHENTICATION (Required for admin access)
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=GENERATE_A_SECURE_JWT_SECRET_MIN_32_CHARS

# Token expiration times
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
