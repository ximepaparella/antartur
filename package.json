    "nodemailer": "^7.0.10",
    "rate-limiter-flexible": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-google-recaptcha": "^3.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.30.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.12",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.3",
    "prisma": "^5.7.0",
    "sass": "^1.80.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
