{
  "name": "antartur-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"const v=process.version.match(/v(\\d+)/)[1];if(parseInt(v)<20){console.error('❌ Node.js 20+ required. Current: '+process.version);process.exit(1)}\" && prisma generate && next build",
    "build:safe": "source ~/.nvm/nvm.sh && nvm use 20 && prisma generate && next build",
    "start": "node .next/standalone/server.js",
    "start:dev": "next start",
    "lint": "next lint",
    "lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@prisma/client": "^5.22.0",
    "@types/dompurify": "^3.0.5",
    "@types/nodemailer": "^7.0.3",
    "dompurify": "^3.3.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.7",
    "nodemailer": "^7.0.10",
    "rate-limiter-flexible": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-google-recaptcha": "^3.1.0",
    "recharts": "^3.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.30.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.12",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.3",
    "prisma": "^5.7.0",
    "sass": "^1.80.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^4.0.12",
    "zod": "^3.25.76"
  }
}
