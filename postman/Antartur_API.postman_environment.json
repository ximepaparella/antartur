{
  "id": "antartur-env",
  "name": "Antartur API - Development",
  "values": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "default",
      "enabled": true
    },
    {
      "key": "api_url",
      "value": "{{base_url}}/api",
      "type": "default",
      "enabled": true
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "secret",
      "enabled": false
    }
  ],
  "_postman_variable_scope": "environment"
}

